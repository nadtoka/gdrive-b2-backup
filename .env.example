# App Configuration
APP_HOST=0.0.0.0
APP_PORT=8080
DATA_DIR=./data
LOG_LEVEL=INFO

# Backblaze B2 Configuration (S3-compatible or native B2)
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET=your-gdrive-backup-bucket
# Optional S3 endpoint if using S3 mode instead of native B2 mode (e.g., s3.us-west-004.backblazeb2.com)
B2_S3_ENDPOINT=

# Google Drive Service Account (Default credentials path)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json

# Safety & Tuning
# Export formats for Google Docs, Sheets, Slides
GDRIVE_EXPORT_FORMATS=docx,xlsx,pptx
RCLONE_TRANSFERS=8
RCLONE_CHECKERS=16
# Alert / abort threshold if more than N files are deleted in a single run (0 = disabled)
MAX_DELETE_THRESHOLD=500

# Optional Webhook for alerts (Slack / Telegram / Discord compatible webhook URL)
ALERT_WEBHOOK_URL=
